struct SceneObject {
    std::string name;
    Mesh* pMesh;
    Texture2D* pTexture;
    glm::vec3 position;
    glm::vec3 scale;
    float rotationAngleDeg;
    glm::vec3 rotationAxis;
    bool isLoaded;
    int alphaTest;
    int isEmissive;
};

const int MAX_SCENE_OBJECTS = 500;
SceneObject gSceneObjects[MAX_SCENE_OBJECTS];
int gNumSceneObjects = 0;

std::map<std::string, Mesh*> gMeshCache;
std::map<std::string, Texture2D*> gTextureCache;

void addObject(const std::string& name, const std::string& objPath,
               const std::string& texPath, glm::vec3 pos, glm::vec3 scale,
               float rotAngle = 0.0f,
               glm::vec3 rotAxis = glm::vec3(0.0f, 1.0f, 0.0f),
               int alphaTest = 0, int isEmissive = 0)
{
    if (gNumSceneObjects >= MAX_SCENE_OBJECTS) return;
    SceneObject& obj = gSceneObjects[gNumSceneObjects++];
    obj.name = name;
    obj.position = pos;
    obj.scale = scale;
    obj.rotationAngleDeg = rotAngle;
    obj.rotationAxis = rotAxis;
    obj.alphaTest = alphaTest;
    obj.isEmissive = isEmissive;
    obj.isLoaded = false;
    obj.pMesh = nullptr;
    obj.pTexture = nullptr;

    auto itMesh = gMeshCache.find(objPath);
    if (itMesh != gMeshCache.end()) {
        obj.pMesh = itMesh->second;
    } else {
        std::cout << "[Load Mesh] " << objPath << " ... " << std::flush;
        Mesh* m = new Mesh();
        if (m->loadOBJ(objPath)) {
            gMeshCache[objPath] = m;
            obj.pMesh = m;
        } else {
            delete m;
            std::cout << "SKIP" << std::endl;
        }
    }

    if (obj.pMesh) {
        auto itTex = gTextureCache.find(texPath);
        if (itTex != gTextureCache.end()) {
            obj.pTexture = itTex->second;
        } else {
            Texture2D* t = new Texture2D();
            t->loadTexture(texPath, true);
            gTextureCache[texPath] = t;
            obj.pTexture = t;
        }
        obj.isLoaded = true;
    }
}

