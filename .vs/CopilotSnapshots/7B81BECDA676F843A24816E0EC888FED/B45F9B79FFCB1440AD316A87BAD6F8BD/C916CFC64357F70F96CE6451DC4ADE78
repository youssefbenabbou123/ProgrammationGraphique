        glm::mat4 view(1.0f);
        glm::vec3 camPos;
        glm::vec3 camDir(0.0f, 0.0f, -1.0f);
        if (gCinematicCamera) {
            // -------------------------------------------------------------
            // CAMERA CINEMA : plan fluide (splines de Catmull-Rom) sur le
            // trajet gCamTour - aucun tremblement, regard toujours lisse
            // -------------------------------------------------------------
            const int   N     = gNumCamTour;
            const float TOTAL = gCamTour[N - 1].t;

            // Temps de visite : accumulateur (H = x1 / x3) -> pas de saut en changeant de vitesse
            static double cineTime = 0.0;
            cineTime += dt * (double)gCineSpeed;
            float tt = fmodf((float)cineTime, TOTAL);

            // Fin de tour : les voitures repartent de leur position de depart
            static float lastTourTt = 0.0f;
            if (tt < lastTourTt) {
                for (int c = 0; c < NUM_ROAD_CARS; c++)
                    gRoadCars[c].x = gRoadCars[c].x0;
            }
            lastTourTt = tt;

            int i = 0;
            while (i < N - 2 && tt >= gCamTour[i + 1].t) i++;
            float u = (tt - gCamTour[i].t) / (gCamTour[i + 1].t - gCamTour[i].t);

            auto catmull = [](const glm::vec3& p0, const glm::vec3& p1,
                              const glm::vec3& p2, const glm::vec3& p3, float t) {
                float t2 = t * t;
                float t3 = t2 * t;
                return 0.5f * (2.0f * p1 + (-p0 + p2) * t +
                               (2.0f * p0 - 5.0f * p1 + 4.0f * p2 - p3) * t2 +
                               (-p0 + 3.0f * p1 - 3.0f * p2 + p3) * t3);
            };

            const CamShot& s0 = gCamTour[i > 0     ? i - 1 : 0];
            const CamShot& s1 = gCamTour[i];
            const CamShot& s2 = gCamTour[i + 1];
            const CamShot& s3 = gCamTour[i + 2 < N ? i + 2 : N - 1];

            camPos = catmull(s0.pos, s1.pos, s2.pos, s3.pos, u);
            glm::vec3 target = catmull(s0.look, s1.look, s2.look, s3.look, u);

            camDir = target - camPos;
            camDir = (glm::length(camDir) > 0.001f) ? glm::normalize(camDir)
                                                    : glm::vec3(0.0f, 0.0f, -1.0f);
            view = glm::lookAt(camPos, camPos + camDir, glm::vec3(0.0f, 1.0f, 0.0f));
        } else {
            view = fpsCamera.getViewMatrix();
            camPos = fpsCamera.getPosition();
            camDir = fpsCamera.getLook();
        }

        glm::mat4 proj = glm::perspective(glm::radians(fpsCamera.getFOV()),
                                          (float)gWindowWidth/(float)gWindowHeight,
                                          0.1f, 1500.0f);

