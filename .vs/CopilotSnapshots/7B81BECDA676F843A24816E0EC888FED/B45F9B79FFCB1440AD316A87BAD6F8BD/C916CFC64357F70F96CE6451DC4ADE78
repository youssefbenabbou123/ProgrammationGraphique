        lightingShader.setUniform("viewPos",    camPos);

        // 1. DIRECTIONNELLE - Lune (nuit) ou Soleil (jour)
        glm::vec3 moonSkyPos = gDayMode ? glm::vec3(90.0f, 150.0f, 70.0f)    // soleil d'apres-midi
                                        : glm::vec3(-80.0f, 230.0f, -240.0f); // lune
        lightingShader.setUniform("sunLight.direction", glm::normalize(glm::vec3(0.0f, 0.0f, 0.0f) - moonSkyPos));
        if (gDayMode) {
            lightingShader.setUniform("sunLight.ambient",   glm::vec3(0.55f, 0.58f, 0.62f));
            lightingShader.setUniform("sunLight.diffuse",   glm::vec3(0.95f, 0.90f, 0.78f));
            lightingShader.setUniform("sunLight.specular",  glm::vec3(0.35f, 0.35f, 0.32f));
        } else {
            lightingShader.setUniform("sunLight.ambient",   glm::vec3(0.12f, 0.14f, 0.18f));
            lightingShader.setUniform("sunLight.diffuse",   glm::vec3(0.25f, 0.28f, 0.36f));
            lightingShader.setUniform("sunLight.specular",  glm::vec3(0.12f, 0.14f, 0.18f));
        }

        // 2. ENVOI DES 26 POINT LIGHTS AU SHADER (eteintes de jour)
        float todLight = gDayMode ? 0.0f : 1.0f;
        float fireFlicker = 0.85f + 0.15f * sinf((float)cur * 14.0f) + 0.08f * sinf((float)cur * 27.0f);
        for (int i = 0; i < NUM_POINT_LIGHTS; i++) {
            std::string p = "pointLights[" + std::to_string(i) + "].";
            lightingShader.setUniform((p + "position").c_str(), pointLights[i].position);
            glm::vec3 amb = pointLights[i].ambient;
            glm::vec3 dif = pointLights[i].diffuse;
            glm::vec3 spc = pointLights[i].specular;
            if (i == 23) { // Feu de camp
                amb *= fireFlicker;
                dif *= fireFlicker;
                spc *= fireFlicker;
            }
            amb *= todLight; // lampadaires/neons : OFF de jour
            dif *= todLight;
            spc *= todLight;
            lightingShader.setUniform((p + "ambient").c_str(),   amb);
            lightingShader.setUniform((p + "diffuse").c_str(),   dif);
            lightingShader.setUniform((p + "specular").c_str(),  spc);
            lightingShader.setUniform((p + "constant").c_str(),  pointLights[i].constant);
            lightingShader.setUniform((p + "linear").c_str(),    pointLights[i].linear);
            lightingShader.setUniform((p + "exponent").c_str(),  pointLights[i].exponent);
        }

        // Animation des BMW en circulation (boucle d'un bout a l'autre de la route)
        for (int c = 0; c < NUM_ROAD_CARS; c++) {
            RoadCar& rc = gRoadCars[c];
            if (rc.objIndex < 0) continue;
            rc.x += ROAD_CAR_SPEED * rc.dir * (float)dt;
            if (rc.dir < 0.0f && rc.x < -180.0f) rc.x =  180.0f; // respawn au bout de la route
            if (rc.dir > 0.0f && rc.x >  180.0f) rc.x = -180.0f;
            gSceneObjects[rc.objIndex].position.x = rc.x;
        }

        // 3. SPOTLIGHT - Torche camera (F)
        glm::vec3 spotPos = camPos; spotPos.y -= 0.3f;
        lightingShader.setUniform("spotLight.position",     spotPos);
        lightingShader.setUniform("spotLight.direction",    camDir);
        lightingShader.setUniform("spotLight.ambient",      glm::vec3(0.08f,0.08f,0.08f));
        lightingShader.setUniform("spotLight.diffuse",      glm::vec3(1.40f,1.38f,1.35f));
        lightingShader.setUniform("spotLight.specular",     glm::vec3(1.20f,1.20f,1.20f));
        lightingShader.setUniform("spotLight.cosInnerCone", glm::cos(glm::radians(12.5f)));
        lightingShader.setUniform("spotLight.cosOuterCone", glm::cos(glm::radians(20.0f)));
        lightingShader.setUniform("spotLight.constant",     1.0f);
        lightingShader.setUniform("spotLight.linear",       0.045f);
        lightingShader.setUniform("spotLight.exponent",     0.0075f);
        lightingShader.setUniform("spotLight.on",           (gFlashlightOn && !gDayMode) ? 1 : 0);

        // 4. PHARES - 2 spots froids par voiture en circulation (8 projecteurs)
        for (int c = 0; c < NUM_ROAD_CARS; c++) {
            const RoadCar& rc = gRoadCars[c];
            for (int h = 0; h < 2; h++) {
                float lateral = ((h == 0) ? 0.72f : -0.72f) * (-rc.dir);
                std::string hp = "headlights[" + std::to_string(c * 2 + h) + "].";
                lightingShader.setUniform((hp + "position").c_str(),
                    glm::vec3(rc.x + rc.dir * 2.35f, carY + 0.65f, rc.z + lateral));
                lightingShader.setUniform((hp + "direction").c_str(),
                    glm::normalize(glm::vec3(rc.dir, -0.09f, 0.0f)));
                lightingShader.setUniform((hp + "cosInnerCone").c_str(), (float)cos(glm::radians(14.0)));
                lightingShader.setUniform((hp + "cosOuterCone").c_str(), (float)cos(glm::radians(24.0)));
                lightingShader.setUniform((hp + "ambient").c_str(),  glm::vec3(0.010f, 0.012f, 0.016f));
                lightingShader.setUniform((hp + "diffuse").c_str(),  glm::vec3(1.25f, 1.28f, 1.35f));
                lightingShader.setUniform((hp + "specular").c_str(), glm::vec3(0.85f, 0.88f, 0.95f));
                lightingShader.setUniform((hp + "on").c_str(),       gDayMode ? 0 : 1);
                lightingShader.setUniform((hp + "constant").c_str(), 1.0f);
                lightingShader.setUniform((hp + "linear").c_str(),   0.035f);
                lightingShader.setUniform((hp + "exponent").c_str(), 0.0055f);
            }
        }

        // Animation des flammes du feu de camp
        if (gCampfireFlamesIndex >= 0 && gCampfireFlamesIndex < gNumSceneObjects) {
            float firePulseY  = 1.1f * (1.0f + 0.12f * sinf((float)cur * 14.0f) + 0.06f * cosf((float)cur * 23.0f));
            float firePulseXZ = 1.1f * (1.0f + 0.05f * sinf((float)cur * 11.0f));
            gSceneObjects[gCampfireFlamesIndex].scale = glm::vec3(firePulseXZ, firePulseY, firePulseXZ);
        }

        // DESSIN DES OBJETS
        for (int i = 0; i < gNumSceneObjects; i++) {
            if (!gSceneObjects[i].isLoaded) continue;
            if (gDayMode && i == gMoonIndex) continue; // pas de lune le jour
            glm::mat4 mdl(1.0f);
            mdl = glm::translate(mdl, gSceneObjects[i].position);
            if (gSceneObjects[i].rotationAngleDeg != 0.0f)
                mdl = glm::rotate(mdl, glm::radians(gSceneObjects[i].rotationAngleDeg),
                                  gSceneObjects[i].rotationAxis);
            mdl = glm::scale(mdl, gSceneObjects[i].scale);
            lightingShader.setUniform("model", mdl);
            lightingShader.setUniform("alphaTest", gSceneObjects[i].alphaTest);
            lightingShader.setUniform("isEmissive", gSceneObjects[i].isEmissive);
            lightingShader.setUniform("material.ambient",  glm::vec3(0.18f,0.18f,0.18f));
            lightingShader.setUniformSampler("material.diffuseMap", 0);
            lightingShader.setUniform("material.specular", glm::vec3(0.50f,0.50f,0.50f));
            lightingShader.setUniform("material.shininess", 64.0f);
            if (gSceneObjects[i].pTexture) gSceneObjects[i].pTexture->bind(0);
            if (gSceneObjects[i].pMesh)    gSceneObjects[i].pMesh->draw();
            if (gSceneObjects[i].pTexture) gSceneObjects[i].pTexture->unbind(0);
        }

        // BULBES RAYONNANTS (Tous les lampadaires, enseignes, auvents et feu)
        // Eteints de jour : pas de halo sur les lampadaires ni sur les phares
        if (!gDayMode) {
        bulbShader.use();
        bulbShader.setUniform("view",       view);
        bulbShader.setUniform("projection", proj);
        float fireFlickerBulb = 0.85f + 0.15f * sinf((float)cur * 14.0f) + 0.08f * sinf((float)cur * 27.0f);

        for (const auto& b : sceneBulbs) {
            glm::mat4 bm = glm::translate(glm::mat4(1.0f), b.pos);
            bm = glm::scale(bm, glm::vec3(b.sc));
            bulbShader.setUniform("model",      bm);
            bulbShader.setUniform("lightColor", b.col);
            bulbMesh.draw();
        }

        // Bulbes specifiques au feu de camp (avec scintillement de couleur vive)
        {
            glm::mat4 bm = glm::translate(glm::mat4(1.0f), glm::vec3(-35.0f, 0.70f, 46.0f));
            bm = glm::scale(bm, glm::vec3(0.65f));
            bulbShader.setUniform("model",      bm);
            bulbShader.setUniform("lightColor", glm::vec3(fireFlickerBulb * 1.50f, fireFlickerBulb * 0.65f, 0.12f));
            bulbMesh.draw();
        }

        // Bulbes des BMW en circulation : 2 phares blancs + 2 feux arriere rouges
        for (int c = 0; c < NUM_ROAD_CARS; c++) {
            const RoadCar& rc = gRoadCars[c];
            float side = -rc.dir; // lateral monde du cote +X local du modele
            struct CarGlow { glm::vec3 pos; glm::vec3 col; float sc; };
            CarGlow glows[4] = {
                { glm::vec3(rc.x + rc.dir * 2.30f, carY + 0.65f, rc.z + 0.72f * side), glm::vec3(1.35f, 1.35f, 1.25f), 0.16f },
                { glm::vec3(rc.x + rc.dir * 2.30f, carY + 0.65f, rc.z - 0.72f * side), glm::vec3(1.35f, 1.35f, 1.25f), 0.16f },
                { glm::vec3(rc.x - rc.dir * 2.30f, carY + 0.68f, rc.z + 0.72f * side), glm::vec3(1.60f, 0.14f, 0.08f), 0.13f },
                { glm::vec3(rc.x - rc.dir * 2.30f, carY + 0.68f, rc.z - 0.72f * side), glm::vec3(1.60f, 0.14f, 0.08f), 0.13f },
            };
            for (const auto& g : glows) {
                glm::mat4 bm = glm::translate(glm::mat4(1.0f), g.pos);
                bm = glm::scale(bm, glm::vec3(g.sc));
                bulbShader.setUniform("model",      bm);
                bulbShader.setUniform("lightColor", g.col);
                bulbMesh.draw();
            }
        }
        } // fin bulb (nuit uniquement)
        glfwSwapBuffers(gWindow);
    }
    glfwTerminate();
    return 0;
}

bool initOpenGL()
{
    if (!glfwInit()) return false;
    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
    glfwWindowHint(GLFW_OPENGL_PROFILE,        GLFW_OPENGL_CORE_PROFILE);
    glfwWindowHint(GLFW_OPENGL_FORWARD_COMPAT, GL_TRUE);
    gWindow = glfwCreateWindow(gWindowWidth, gWindowHeight, APP_TITLE, NULL, NULL);
    if (!gWindow) { glfwTerminate(); return false; }
    glfwMakeContextCurrent(gWindow);
    glewExperimental = GL_TRUE;
    if (glewInit() != GLEW_OK) return false;
    glfwSetKeyCallback(gWindow, glfw_onKey);
    glfwSetFramebufferSizeCallback(gWindow, glfw_onFramebufferSize);
    glfwSetScrollCallback(gWindow, glfw_onMouseScroll);
    glfwSetInputMode(gWindow, GLFW_CURSOR, GLFW_CURSOR_DISABLED);
    glfwSetCursorPos(gWindow, gWindowWidth/2.0, gWindowHeight/2.0);
    glClearColor(gClearColor.r, gClearColor.g, gClearColor.b, gClearColor.a);
    int w, h; glfwGetFramebufferSize(gWindow, &w, &h);
    glViewport(0,0,w,h);
    glEnable(GL_DEPTH_TEST);
    return true;
}

void glfw_onKey(GLFWwindow* window, int key, int sc, int action, int mode) {
    if (key == GLFW_KEY_ESCAPE && action == GLFW_PRESS)
        glfwSetWindowShouldClose(window, GL_TRUE);
    if (key == GLFW_KEY_E && action == GLFW_PRESS) {
        gWireframe = !gWireframe;
        glPolygonMode(GL_FRONT_AND_BACK, gWireframe ? GL_LINE : GL_FILL);
    }
    if (key == GLFW_KEY_F && action == GLFW_PRESS) {
        gFlashlightOn = !gFlashlightOn;
        std::cout << "[Spotlight] " << (gFlashlightOn ? "ON" : "OFF") << std::endl;
    }
    if (key == GLFW_KEY_C && action == GLFW_PRESS) {
        gCinematicCamera = !gCinematicCamera;
        std::cout << "[Camera Cin.] " << (gCinematicCamera ? "ON" : "OFF") << std::endl;
    }
    if (key == GLFW_KEY_N && action == GLFW_PRESS) {
        gDayMode = !gDayMode;
        gClearColor = gDayMode ? CLEAR_DAY : CLEAR_NIGHT;
        glClearColor(gClearColor.r, gClearColor.g, gClearColor.b, gClearColor.a);
        std::cout << "[Jour/Nuit] " << (gDayMode ? "JOUR" : "NUIT") << std::endl;
    }
    if (key == GLFW_KEY_H && action == GLFW_PRESS) {
        gCineSpeed = (gCineSpeed > 1.5f) ? 1.0f : 3.0f;
        std::cout << "[Vitesse camera] x" << gCineSpeed << std::endl;
    }
    if (key == GLFW_KEY_F11 && action == GLFW_PRESS) {
        gFullscreen = !gFullscreen;
        if (gFullscreen) {
            // Fenetre maximisee (et non plein ecran exclusif) pour rester
            // fluide et compatible avec les captures d'ecran (OBS, Win+G...)
            glfwGetWindowSize(gWindow, &gWindowedW, &gWindowedH);
            glfwGetWindowPos(gWindow, &gWindowedX, &gWindowedY);
            glfwMaximizeWindow(gWindow);
        } else {
            glfwRestoreWindow(gWindow);
            glfwSetWindowPos(gWindow, gWindowedX, gWindowedY);
            glfwSetWindowSize(gWindow, gWindowedW, gWindowedH);
        }
        std::cout << "[Plein ecran] " << (gFullscreen ? "ON" : "OFF") << std::endl;
    }
}
void glfw_onFramebufferSize(GLFWwindow* w, int width, int height) {
    gWindowWidth = width; gWindowHeight = height;
    int fw, fh; glfwGetFramebufferSize(gWindow, &fw, &fh);
    glViewport(0,0,fw,fh);
}
void glfw_onMouseScroll(GLFWwindow* w, double dx, double dy) {
    double fov = fpsCamera.getFOV() + dy * ZOOM_SENSITIVITY;
    fov = glm::clamp(fov, 1.0, 120.0);
    fpsCamera.setFOV((float)fov);
}
void update(double dt) {
    if (gCinematicCamera) return;
    double mx, my;
    glfwGetCursorPos(gWindow, &mx, &my);
    fpsCamera.rotate((float)(gWindowWidth/2.0-mx)*MOUSE_SENSITIVITY,
                     (float)(gWindowHeight/2.0-my)*MOUSE_SENSITIVITY);
    glfwSetCursorPos(gWindow, gWindowWidth/2.0, gWindowHeight/2.0);

    float speed = MOVE_SPEED;
    if (glfwGetKey(gWindow, GLFW_KEY_LEFT_SHIFT) == GLFW_PRESS ||
        glfwGetKey(gWindow, GLFW_KEY_RIGHT_SHIFT) == GLFW_PRESS) {
        speed *= 2.2f; // Sprint turbo (61 m/s)
    }

    if (glfwGetKey(gWindow,GLFW_KEY_W)==GLFW_PRESS)
        fpsCamera.move( speed*(float)dt*fpsCamera.getLook());
    else if (glfwGetKey(gWindow,GLFW_KEY_S)==GLFW_PRESS)
        fpsCamera.move(-speed*(float)dt*fpsCamera.getLook());
    if (glfwGetKey(gWindow,GLFW_KEY_A)==GLFW_PRESS)
        fpsCamera.move(-speed*(float)dt*fpsCamera.getRight());
    else if (glfwGetKey(gWindow,GLFW_KEY_D)==GLFW_PRESS)
        fpsCamera.move( speed*(float)dt*fpsCamera.getRight());
    if (glfwGetKey(gWindow,GLFW_KEY_Z)==GLFW_PRESS)
        fpsCamera.move( speed*(float)dt*glm::vec3(0,1,0));
    else if (glfwGetKey(gWindow,GLFW_KEY_X)==GLFW_PRESS)
        fpsCamera.move(-speed*(float)dt*glm::vec3(0,1,0));
}
void showFPS(GLFWwindow* window) {
    static double prev=0.0; static int frames=0;
    double cur=glfwGetTime(), el=cur-prev;
    if (el>0.25) {
        prev=cur; double fps=frames/el;
        std::ostringstream o; o.precision(2);
        o << std::fixed << APP_TITLE << "  |  FPS: " << fps
          << "  |  [F]Torche [E]Wire [C]Cinema [N]" << (gDayMode ? "Jour" : "Nuit");
        glfwSetWindowTitle(window, o.str().c_str());
        frames=0;
    }
    frames++;
}