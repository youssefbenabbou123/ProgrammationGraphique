# Randomize leading whitespace of CODE lines only (comments untouched).
# Rules:
#  - lines whose trimmed text starts with // or /* or * or # are left as-is
#  - empty lines stay empty
#  - code lines: leading indentation replaced by 0..10 spaces OR 1-2 tabs + random spaces (random, no pattern)
$files = @("main.cpp","Camera.cpp","Camera.hpp","Mesh.cpp","Mesh.h",
		   "ShaderProgram.cpp","ShaderProgram.h","Texture2D.cpp","Texture2D.h",
		   "TerrainHeight.cpp","TerrainHeight.h")
$rng = New-Object System.Random(20102024)
foreach ($f in $files) {
	if (-not (Test-Path $f)) { Write-Host "skip $f"; continue }
	$lines = Get-Content $f
	$out = New-Object System.Collections.Generic.List[string]
	foreach ($ln in $lines) {
		$trim = $ln.TrimStart()
		if ($trim.Length -eq 0) { $out.Add(""); continue }
		if ($trim.StartsWith("//") -or $trim.StartsWith("/*") -or $trim.StartsWith("*") -or $trim.StartsWith("#")) {
			$out.Add($ln); continue
		}
		$r = $rng.Next(100)
		if ($r -lt 70) {
			$indent = " " * $rng.Next(0, 11)          # 0-10 spaces
		} elseif ($r -lt 88) {
			$indent = "`t" + (" " * $rng.Next(0, 4))  # tab + 0-3 spaces
		} else {
			$indent = ("`t" * $rng.Next(1, 3)) + (" " * $rng.Next(0, 3))
		}
		$out.Add($indent + $trim)
	}
	[System.IO.File]::WriteAllLines((Resolve-Path $f).Path, $out)
	Write-Host "done $f"
}
